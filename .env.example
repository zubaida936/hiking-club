APP_NAME="Hiking Club"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hiking
DB_USERNAME=hiking
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hiking.test"
MAIL_FROM_NAME="${APP_NAME}"

# How member password-reset codes are sent: mail (to the member's email) or log (development).
MEMBER_CODE_CHANNEL=mail

# Event payments (config/payments.php). Club wallet accounts hikers send money to:
PAYMENT_WHISH_NAME="Hiking Club"
PAYMENT_WHISH_NUMBER="+961 70 000 000"
PAYMENT_OMT_NAME="Hiking Club"
PAYMENT_OMT_NUMBER="+961 70 000 000"
# Online payment ("Pay now"): empty = off; "test" = built-in simulator (never in production).
PAYMENT_ONLINE_GATEWAY=

# Shop (config/shop.php): flat delivery fee in cents; where "new order" emails go (defaults to SITE_EMAIL).
SHOP_DELIVERY_FEE_CENTS=400
SHOP_NOTIFY_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker ports
APP_PORT=8080
VITE_PORT=5173
FORWARD_DB_PORT=33060
MAILPIT_UI_PORT=8025
PMA_PORT=8081

# Initial CMS super admin (used by AdminUserSeeder)
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@hiking.test
ADMIN_PASSWORD=password

# Public site contact details and social handles (see config/site.php; empty social handle = hidden)
SITE_ADDRESS="Beirut, Lebanon"
SITE_PHONE="+961 00 000 000"
SITE_WHATSAPP=96100000000
SITE_EMAIL=hello@hiking.test
SITE_FACEBOOK=hikingclub
SITE_INSTAGRAM=hikingclub
SITE_TIKTOK=hikingclub
SITE_YOUTUBE=hikingclub

# Google Analytics 4 measurement ID (G-XXXXXXX); empty = no analytics
GOOGLE_ANALYTICS_ID=
